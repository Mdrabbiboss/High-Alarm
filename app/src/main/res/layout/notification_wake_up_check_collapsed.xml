<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Are You Awake? ☀️"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F2EEE6" />

        <TextView
            android:id="@+id/notification_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to confirm"
            android:textSize="11sp"
            android:textColor="#8E8B95" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_confirm_awake"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:paddingHorizontal="14dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/notification_button_bg"
        android:gravity="center"
        android:text="CONFIRM"
        android:textColor="#07070A"
        android:textStyle="bold"
        android:textSize="12sp" />

</LinearLayout>